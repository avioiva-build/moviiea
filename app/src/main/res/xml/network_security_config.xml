<?xml version="1.0" encoding="utf-8"?>
<!-- Moviiea v2.6 — some video servers still serve stream parts over
     plain http. Allow that so playback never stalls on it. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
